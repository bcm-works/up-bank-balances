{
  "$schema": "https://deno.land/x/deno/cli/schemas/config-file.v1.json",
  "nodeModulesDir": "auto",
  "preferPackageJson": false,
  "minimumDependencyAge": 14,
  "lock": true,
  "imports": {
    "-/": "./src/",
    "-/up/": "./src/up-bank/",
    "@oak/oak": "jsr:@oak/oak@^17.2.0",
    "moment": "npm:moment@^2.31.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.8",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/path": "jsr:@std/path@^1.1.6"
  },
  "tasks": {
    "cli": {
      "description": "Show your bank account balances in the terminal.",
      "command": "deno run --allow-net --allow-read --allow-env src/cli.ts"
    },
    "web": {
      "description": "Show your bank account balances in a web browser.",
      "command": "deno run --allow-net --allow-write=./ --allow-read --allow-env src/web.ts"
    },
    "deps": {
      "description": "Update Deno dependencies.",
      "command": "deno outdated --update --latest || true"
    },
    "check": {
      "description": "Run Deno linting and formatting tools.",
      "command": "deno lint && deno fmt"
    }
  },
  "compilerOptions": {
    "allowUnreachableCode": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true
  },
  "fmt": {
    "include": [
      "src/",
      "deno.json"
    ],
    "lineWidth": 120,
    "useTabs": false,
    "indentWidth": 2,
    "singleQuote": false,
    "semiColons": true,
    "bracePosition": "sameLine",
    "operatorPosition": "sameLine",
    "trailingCommas": "never",
    "useBraces": "whenNotSingleLine"
  },
  "lint": {
    "include": [
      "src/",
      "deno.json"
    ]
  }
}
